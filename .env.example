# Neon Postgres. The migrator and API use the allsquare schema only.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# HS256 secret for the app JWT (about 90 days).
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=

# Google OAuth web client ID. The API checks the ID token audience against this.
GOOGLE_CLIENT_ID=
